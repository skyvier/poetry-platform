cabal-version:      2.4
name:               poems-platform
version:            0.1.0
build-type:         Simple

common shared
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >=4 && <5, text, containers

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Poem, Seal
  build-depends:    bytestring, crypton, memory

executable site
  import:           shared
  main-is:          site.hs
  build-depends:    poems-platform, hakyll, filepath, directory, bytestring,
                    base64-bytestring, base16-bytestring, aeson, crypton
  ghc-options:      -threaded

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  other-modules:    PoemSpec, SealSpec
  build-depends:    poems-platform, hspec, bytestring, base16-bytestring
